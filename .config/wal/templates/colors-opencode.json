{{
  "$schema": "https://opencode.ai/theme.json",
  "base": {{
    "categorical": [
      "regular",
      "light",
      "neutral"
    ],
    "text": {{
      "base": "$hue.regular.800",
      "muted": "$hue.regular.700",
      "action": {{
        "primary": {{
          "base": "$text.base",
          "$focused": "$hue.neutral.900",
          "$selected": "$hue.regular.700",
          "$disabled": "$hue.neutral.400"
        }},
        "secondary": {{
          "base": "$text.muted",
          "$hovered": "$text.base"
        }},
        "destructive": {{
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }}
      }},
      "formfield": {{
        "base": "$hue.regular.800",
        "$hovered": "$hue.accent.400",
        "$focused": "$hue.regular.700",
        "$pressed": "$hue.regular.400",
        "$selected": "$hue.regular.400",
        "$disabled": "$hue.light.100"
      }},
      "feedback": {{
        "error": {{
          "base": "$hue.regular.200"
        }},
        "warning": {{
          "base": "#f5a742"
        }},
        "success": {{
          "base": "$hue.regular.300"
        }},
        "info": {{
          "base": "$hue.regular.700"
        }}
      }}
    }},
    "background": {{
      "base": "$hue.regular.100",
      "raised": {{
        "base": "$hue.neutral.600",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.800"
      }},
      "action": {{
        "primary": {{
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        }},
        "secondary": {{
          "base": "transparent"
        }},
        "destructive": {{
          "base": "$hue.regular.200"
        }}
      }},
      "formfield": {{
        "base": "$background.base"
      }},
      "feedback": {{
        "error": {{
          "base": "$background.base"
        }},
        "warning": {{
          "base": "$background.base"
        }},
        "success": {{
          "base": "$background.base"
        }},
        "info": {{
          "base": "$background.base"
        }}
      }}
    }},
    "border": {{
      "base": "transparent"
    }},
    "scrollbar": {{
      "base": "#606060"
    }},
    "diff": {{
      "text": {{
        "added": "#4fd6be",
        "removed": "#c53b53",
        "context": "#828bb8",
        "hunkHeader": "#828bb8"
      }},
      "background": {{
        "added": "#20303b",
        "removed": "#37222c",
        "context": "$hue.neutral.600"
      }},
      "highlight": {{
        "added": "#b8db87",
        "removed": "#e26a75"
      }},
      "lineNumber": {{
        "text": "#8f8f8f",
        "background": {{
          "added": "#1b2b34",
          "removed": "#2d1f26"
        }}
      }}
    }},
    "syntax": {{
      "comment": "$hue.neutral.400",
      "keyword": "$hue.regular.400",
      "function": "$hue.interactive.500",
      "variable": "$hue.regular.200",
      "string": "$hue.regular.300",
      "number": "#f5a742",
      "type": "#e5c07b",
      "operator": "$hue.regular.600",
      "punctuation": "$hue.neutral.200"
    }},
    "markdown": {{
      "text": "$hue.neutral.200",
      "heading": "$hue.accent.400",
      "link": "$hue.interactive.600",
      "linkText": "$hue.neutral.200",
      "code": "$hue.regular.300",
      "blockQuote": "#e5c07b",
      "emphasis": "#e5c07b",
      "strong": "#f5a742",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.neutral.200",
      "image": "$hue.interactive.200",
      "imageText": "$hue.neutral.200",
      "codeBlock": "$hue.neutral.200"
    }},
    "@dialog": {{
      "background": {{
        "base": "$hue.regular.100",
        "action": {{
          "primary": {{
            "$hovered": "$background.raised.high",
            "$focused": "$hue.accent.700"
          }}
        }}
      }}
    }}
  }},
  "light": {{
    "hue": {{
      "accent": "$hue.regular",
      "interactive": "$hue.light",
      "neutral": "$hue.gray",
      "regular": {{
        "100": "{color0}",
        "200": "{color1}",
        "300": "{color2}",
        "400": "{color3}",
        "500": "{color4}",
        "600": "{color5}",
        "700": "{color6}",
        "800": "{color7}",
        "900": "#ffffff"
      }},
      "light": {{
        "100": "{color8}",
        "200": "{color9}",
        "300": "{color10}",
        "400": "{color11}",
        "500": "{color12}",
        "600": "{color13}",
        "700": "{color14}",
        "800": "{color15}",
        "900": "#ffffff"
      }},
      "gray": {{
        "100": "#030303",
        "200": "#0a0a0a",
        "300": "#141414",
        "400": "#4c4c4c",
        "500": "#808080",
        "600": "#b5b5b5",
        "700": "#d1d5db",
        "800": "#eeeeee",
        "900": "#fefefe"
      }}
    }},
    "text": {{
      "base": "$hue.regular.100",
      "muted": "$hue.regular.200",
      "action": {{
        "primary": {{
          "$selected": "$hue.interactive.200"
        }},
        "destructive": {{
          "base": "$hue.regular.900",
          "$disabled": "$hue.gray.400"
        }}
      }},
      "formfield": {{
        "base": "$hue.regular.100",
        "$hovered": "$hue.light.200",
        "$focused": "$hue.light.200",
        "$pressed": "$hue.light.200",
        "$selected": "$hue.light.200",
        "$disabled": "$hue.neutral.400"
      }},
      "feedback": {{
        "warning": {{
          "base": "$hue.regular.400"
        }}
      }}
    }},
    "background": {{
      "base": "$hue.regular.900",
      "raised": {{
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.800",
        "max": "$hue.neutral.700"
      }},
      "action": {{
        "primary": {{
          "$hovered": "$hue.regular.700",
          "$focused": "$hue.regular.700"
        }},
        "destructive": {{
          "base": "$hue.light.200"
        }}
      }}
    }},
    "border": {{
      "base": "#b8b8b8"
    }},
    "scrollbar": {{
      "base": "#a0a0a0"
    }},
    "diff": {{
      "text": {{
        "added": "#1e725c",
        "context": "#7086b5",
        "hunkHeader": "#7086b5"
      }},
      "background": {{
        "added": "#d5e5d5",
        "removed": "#f7d8db",
        "context": "$hue.neutral.700"
      }},
      "highlight": {{
        "added": "#4db380",
        "removed": "#f52a65"
      }},
      "lineNumber": {{
        "text": "#595959",
        "background": {{
          "added": "#c5d5c5",
          "removed": "#e7c8cb"
        }}
      }}
    }},
    "syntax": {{
      "keyword": "$hue.accent.200",
      "function": "$hue.interactive.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.neutral.200",
      "number": "$hue.accent.200",
      "type": "#b0851f",
      "operator": "$hue.neutral.200"
    }},
    "markdown": {{
      "link": "$hue.interactive.200",
      "blockQuote": "#b0851f",
      "emphasis": "#b0851f",
      "strong": "$hue.accent.200",
      "listItem": "$hue.interactive.700",
      "listEnumeration": "$hue.regular.700"
    }},
    "@dialog": {{
      "background": {{
        "base": "$background.raised.base"
      }}
    }}
  }},
  "dark": {{
    "hue": {{
      "accent": "$hue.regular",
      "interactive": "$hue.light",
      "neutral": "$hue.gray",
      "regular": {{
        "100": "{color0}",
        "200": "{color1}",
        "300": "{color2}",
        "400": "{color3}",
        "500": "{color4}",
        "600": "{color5}",
        "700": "{color6}",
        "800": "{color7}",
        "900": "#000000"
      }},
      "light": {{
        "100": "{color8}",
        "200": "{color9}",
        "300": "{color10}",
        "400": "{color11}",
        "500": "{color12}",
        "600": "{color13}",
        "700": "{color14}",
        "800": "{color15}",
        "900": "#000000"
      }},
      "gray": {{
        "100": "#fefefe",
        "200": "#eeeeee",
        "300": "#b5b5b5",
        "400": "#808080",
        "500": "#4c4c4c",
        "600": "#1e1e1e",
        "700": "#141414",
        "800": "#0a0a0a",
        "900": "#030303"
      }}
    }}
  }}
}}
