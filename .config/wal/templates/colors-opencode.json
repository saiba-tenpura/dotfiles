{{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {{
    "background": "{color0}",
    "foreground": "{color7}",
    "red": "{color1}",
    "green": "{color2}",
    "yellow": "{color3}",
    "blue": "{color4}",
    "magenta": "{color5}",
    "cyan": "{color6}",
    "light-background": "{color8}",
    "light-foreground": "{color15}",
    "light-red": "{color9}",
    "light-green": "{color10}",
    "light-yellow": "{color11}",
    "light-blue": "{color12}",
    "light-magenta": "{color13}",
    "light-cyan": "{color14}"
  }},
  "theme": {{
    "primary": {{
      "dark": "cyan",
      "light": "cyan"
    }},
    "secondary": {{
      "dark": "magenta",
      "light": "magenta"
    }},
    "accent": {{
      "dark": "blue",
      "light": "blue"
    }},
    "error": {{
      "dark": "red",
      "light": "red"
    }},
    "warning": {{
      "dark": "yellow",
      "light": "yellow"
    }},
    "success": {{
      "dark": "green",
      "light": "green"
    }},
    "info": {{
      "dark": "blue",
      "light": "blue"
    }},
    "text": {{
      "dark": "foreground",
      "light": "background"
    }},
    "textMuted": {{
      "dark": "light-foreground",
      "light": "light-background"
    }},
    "background": {{
      "dark": "background",
      "light": "foreground"
    }},
    "backgroundPanel": {{
      "dark": "light-background",
      "light": "light-foreground"
    }},
    "backgroundElement": {{
      "dark": "light-background",
      "light": "light-foreground"
    }},
    "border": {{
      "dark": "background",
      "light": "foreground"
    }},
    "borderActive": {{
      "dark": "red",
      "light": "red"
    }},
    "borderSubtle": {{
      "dark": "green",
      "light": "yellow"
    }},
    "diffAdded": {{
      "dark": "light-green",
      "light": "light-green"
    }},
    "diffRemoved": {{
      "dark": "light-red",
      "light": "light-red"
    }},
    "diffContext": {{
      "dark": "yellow",
      "light": "yellow"
    }},
    "diffHunkHeader": {{
      "dark": "yellow",
      "light": "yellow"
    }},
    "diffHighlightAdded": {{
      "dark": "light-green",
      "light": "light-green"
    }},
    "diffHighlightRemoved": {{
      "dark": "light-red",
      "light": "light-red"
    }},
    "diffAddedBg": {{
      "dark": "#3B4252",
      "light": "#E5E9F0"
    }},
    "diffRemovedBg": {{
      "dark": "#3B4252",
      "light": "#E5E9F0"
    }},
    "diffContextBg": {{
      "dark": "magenta",
      "light": "magenta"
    }},
    "diffLineNumber": {{
      "dark": "cyan",
      "light": "cyan"
    }},
    "diffAddedLineNumberBg": {{
      "dark": "#3B4252",
      "light": "#E5E9F0"
    }},
    "diffRemovedLineNumberBg": {{
      "dark": "#3B4252",
      "light": "#E5E9F0"
    }},
    "markdownText": {{
      "dark": "blue",
      "light": "background"
    }},
    "markdownHeading": {{
      "dark": "light-background",
      "light": "light-green"
    }},
    "markdownLink": {{
      "dark": "light-red",
      "light": "light-red"
    }},
    "markdownLinkText": {{
      "dark": "foreground",
      "light": "foreground"
    }},
    "markdownCode": {{
      "dark": "light-cyan",
      "light": "light-cyan"
    }},
    "markdownBlockQuote": {{
      "dark": "yellow",
      "light": "yellow"
    }},
    "markdownEmph": {{
      "dark": "light-blue",
      "light": "light-blue"
    }},
    "markdownStrong": {{
      "dark": "light-magenta",
      "light": "light-magenta"
    }},
    "markdownHorizontalRule": {{
      "dark": "yellow",
      "light": "yellow"
    }},
    "markdownListItem": {{
      "dark": "light-background",
      "light": "light-green"
    }},
    "markdownListEnumeration": {{
      "dark": "foreground",
      "light": "foreground"
    }},
    "markdownImage": {{
      "dark": "light-red",
      "light": "light-red"
    }},
    "markdownImageText": {{
      "dark": "foreground",
      "light": "foreground"
    }},
    "markdownCodeBlock": {{
      "dark": "blue",
      "light": "background"
    }},
    "syntaxComment": {{
      "dark": "yellow",
      "light": "yellow"
    }},
    "syntaxKeyword": {{
      "dark": "light-red",
      "light": "light-red"
    }},
    "syntaxFunction": {{
      "dark": "light-background",
      "light": "light-background"
    }},
    "syntaxVariable": {{
      "dark": "foreground",
      "light": "foreground"
    }},
    "syntaxString": {{
      "dark": "light-cyan",
      "light": "light-cyan"
    }},
    "syntaxNumber": {{
      "dark": "light-foreground",
      "light": "light-foreground"
    }},
    "syntaxType": {{
      "dark": "foreground",
      "light": "foreground"
    }},
    "syntaxOperator": {{
      "dark": "light-red",
      "light": "light-red"
    }},
    "syntaxPunctuation": {{
      "dark": "blue",
      "light": "background"
    }}
  }}
}}
